---
import { MaternalMortalityPanel } from './MaternalMortalityPanel'
import type { MaternalMortalityRateRow } from '@/lib/parquet'

interface Props {
  title: string
  text: string
  data: MaternalMortalityRateRow[] | undefined
  csvPath?: string
  source: string
}

const { title, text, data, csvPath, source } = Astro.props
---

<div class="mx-auto max-w-7xl px-2 sm:px-6 lg:px-10">
  <div class="flex flex-col gap-2">
    <h1 class="text-3xl font-bold my-6">{title}</h1>
    <p class="text-gray-700">{text}</p>
    {
      data && (
        <MaternalMortalityPanel data={data} csvPath={csvPath} client:load />
      )
    }
    <p class="text-sm text-gray-500">Fuente: {source}</p>
  </div>
</div>
